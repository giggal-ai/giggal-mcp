{
  "name": "@giggal/mcp-service",
  "version": "0.1.0",
  "private": true,
  "description": "Giggal.ai MCP server that exposes email verification tools to Claude, ChatGPT, Gemini, and other MCP clients.",
  "license": "MIT",
  "homepage": "https://giggal.ai/mcp",
  "repository": {
    "type": "git",
    "url": "https://github.com/giggal-ai/giggal-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/giggal-ai/giggal-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "email-verification",
    "email-validation",
    "deliverability",
    "giggal",
    "claude",
    "chatgpt"
  ],
  "main": "dist/index.js",
  "bin": {
    "giggal-mcp": "dist/local/index.js"
  },
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "start:local": "node dist/local/index.js",
    "dev:local": "tsx watch src/local/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fastify/cookie": "^9.3.1",
    "@fastify/cors": "^9.0.1",
    "@fastify/formbody": "^7.4.0",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/session": "^10.9.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "bcrypt": "^5.1.1",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "mongodb": "^6.8.0",
    "pino": "^9.3.2",
    "undici": "^6.19.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/node": "^20.14.11",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vitest": "^2.0.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
